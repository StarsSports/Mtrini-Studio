rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global safety net default-deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Validation blueprints
    function isValidUser(data) {
      return data.email is string && data.email.size() <= 200
        && (data.displayName == null || (data.displayName is string && data.displayName.size() <= 100))
        && (data.avatarUrl == null || (data.avatarUrl is string && data.avatarUrl.size() <= 1000))
        && data.credits is int && data.credits >= 0
        && (data.themeColor == null || (data.themeColor is string && data.themeColor.size() <= 50))
        && (data.mcpServer == null || (data.mcpServer is string && data.mcpServer.size() <= 200))
        && (data.isPremiumActive == null || data.isPremiumActive is bool)
        && (data.mcpConfig == null || (data.mcpConfig is string && data.mcpConfig.size() <= 100000))
        && data.createdAt is timestamp;
    }

    function isValidChat(data) {
      return data.title is string && data.title.size() <= 500
        && data.userId is string && data.userId.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMessage(data) {
      return data.role is string && (data.role == 'user' || data.role == 'assistant')
        && data.content is string && data.content.size() <= 100000
        && data.createdAt is timestamp
        && (data.hasArtifact == null || data.hasArtifact is bool)
        && (data.artifactCode == null || (data.artifactCode is string && data.artifactCode.size() <= 500000))
        && (data.artifactTitle == null || (data.artifactTitle is string && data.artifactTitle.size() <= 200))
        && (data.artifactType == null || (data.artifactType is string && data.artifactType.size() <= 100));
    }

    // Collection matches
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming()) && incoming().createdAt == request.time;
      allow update: if isOwner(userId) && isValidUser(incoming()) && incoming().createdAt == existing().createdAt;
    }

    match /chats/{chatId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(chatId) && incoming().userId == request.auth.uid && isValidChat(incoming()) && incoming().createdAt == request.time;
      allow update: if isSignedIn() && existing().userId == request.auth.uid && incoming().userId == request.auth.uid && isValidChat(incoming()) && incoming().createdAt == existing().createdAt && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'updatedAt']);
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    match /chats/{chatId}/messages/{messageId} {
      allow get: if isSignedIn() && get(/databases/$(database)/documents/chats/$(chatId)).data.userId == request.auth.uid;
      allow list: if isSignedIn() && get(/databases/$(database)/documents/chats/$(chatId)).data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(messageId) && get(/databases/$(database)/documents/chats/$(chatId)).data.userId == request.auth.uid && isValidMessage(incoming()) && incoming().createdAt == request.time;
      allow delete: if isSignedIn() && get(/databases/$(database)/documents/chats/$(chatId)).data.userId == request.auth.uid;
    }
  }
}
